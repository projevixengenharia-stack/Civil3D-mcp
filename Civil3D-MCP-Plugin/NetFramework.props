<Project>
  <!-- Civil 3D 2024 (R24.3) hosts .NET Framework 4.8. Active only for builds run with
       /p:TargetFramework=net48 (see scripts\build-2027.ps1); the 2026/2027 builds ignore it. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- C# 14 static extension members back NetFrameworkPolyfills.cs. -->
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Build-time only: records, init, required, Index/Range and ModuleInitializer attributes. -->
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
    <!-- Inbox on .NET 8/10; same major as the 2027 build so JSON behaviour matches. -->
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
